# .env.example — DeepCoin Core
# ==============================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed.
#
# Usage (PowerShell):
#   Copy-Item .env.example .env
#   # Then edit .env with your keys
#
# Usage (Linux / Git Bash):
#   cp .env.example .env

# ── LLM Providers (priority order — first one set wins) ──────────────────────
#
# Option 1: GitHub Models API (recommended for students with Copilot Pro)
#   Free tier, powered by Azure.
#   Get token: https://github.com/settings/tokens
#   Model: gemini-2.5-flash via https://models.inference.ai.azure.com
#
GITHUB_TOKEN=your_github_copilot_token_here

# Option 2: Google AI Studio (free tier: 1,500 req/day)
#   Get key: https://aistudio.google.com/app/apikey
#   Model: gemini-2.5-flash
#
# GOOGLE_API_KEY=your_google_ai_studio_key_here

# Option 3: Ollama (local — no internet required, no cost)
#   Install: https://ollama.com
#   Pull model: ollama pull gemma3:4b
#   Start server: ollama serve
#   Supported models: gemma3:4b, llama3.2:3b, deepseek-r1:8b
#
# OLLAMA_HOST=http://localhost:11434

# ── API Security ─────────────────────────────────────────────────────────────
#
# X-API-Key header required on POST /api/classify when this is set.
# Leave empty (or unset) for local dev — all requests pass through.
# In production, set a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# DEEPCOIN_API_KEY=your-strong-random-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
#
# Comma-separated list of allowed frontend origins.
# Default (if unset): http://localhost:3000
#
# ALLOWED_ORIGINS=http://localhost:3000,https://deepcoin.yourdomain.com

# ── Server configuration ──────────────────────────────────────────────────────
#
# Uvicorn workers — keep at 1 on a single-GPU machine (model loaded once in VRAM).
# UVICORN_WORKERS=1

# ── Storage paths (defaults shown — only override if needed) ──────────────────
#
# DATA_DIR=data
# MODELS_DIR=models
# REPORTS_DIR=reports

# =============================================================================
# DOCKER / PRODUCTION CONFIGURATION
# =============================================================================
# The variables below are only required when running the full Docker stack
# (docker compose up --build). They are optional for local venv development.

#  PostgreSQL 17 (docker compose postgres service) 
#
# These values must match across compose services (postgres, api, migrator).
# For local dev (no Docker), the API falls back to:
#   localhost:5432 / deepcoin / deepcoin (see src/api/db/session.py defaults)
#
POSTGRES_USER=deepcoin
POSTGRES_PASSWORD=deepcoin_change_this_in_prod
POSTGRES_DB=deepcoin

#  Authentication secrets 
#
# JWT_SECRET / SECRET_KEY: used to sign JWTs (access + refresh tokens).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# NEXTAUTH_SECRET / AUTH_SECRET: used by NextAuth.js to sign session cookies.
# Must be the same value in both NEXTAUTH_SECRET and AUTH_SECRET.
# Generate with: openssl rand -base64 32
#
JWT_SECRET=change_me_jwt_secret_32chars_minimum
SECRET_KEY=change_me_secret_key_32chars_minimum
NEXTAUTH_SECRET=change_me_nextauth_secret_32chars
NEXTAUTH_URL=http://localhost

#  CORS 
#
# Comma-separated allowed origins for the FastAPI CORS middleware.
# In Docker: Nginx serves the frontend at http://localhost (port 80).
# In dev:    Next.js dev server is at http://localhost:3000.
#
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

#  MLflow Tracking Server 
#
# In Docker, the MLflow service is at http://mlflow:5000 (Docker DNS).
# The MLflow UI is accessible at http://localhost:5000 from the host machine.
#
# For local venv development (no Docker), point to the local MLflow instance:
#   make mlflow   (see Makefile  starts mlflow server on http://127.0.0.1:5000)
#
MLFLOW_TRACKING_URI=http://mlflow:5000

#  LocalStack S3 (PDF archiving simulation) 
#
# LocalStack provides an S3-compatible API at http://localhost:4566.
# The FastAPI service archives PDF reports to the deepcoin-reports bucket.
#
# To provision the bucket after first start:
#   aws --endpoint-url http://localhost:4566 s3 mb s3://deepcoin-reports
#
# To swap to real AWS S3:
#   1. Remove LOCALSTACK_ENDPOINT_URL (let boto3 use the real AWS endpoint)
#   2. Replace the test credentials with real IAM user credentials
#
LOCALSTACK_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=deepcoin-reports
