# frontend/.dockerignore — Next.js Docker build context
# =======================================================
# Applied when `docker build` is run from the frontend/ directory
# (as in the docker-compose.yml web service: `context: ./frontend`).

# ── Node dependencies (reinstalled during build from package-lock.json)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Next.js build output (rebuilt during `npm run build` in the builder stage)
.next/
out/

# ── Environment files (secrets injected at runtime, not baked into image)
.env
.env.local
.env.*.local
!.env.example

# ── Git
.git/
.gitignore

# ── IDE
.vscode/
.idea/
*.DS_Store

# ── TypeScript build info (regenerated during build)
*.tsbuildinfo

# ── Test artifacts
coverage/
.nyc_output/

# ── Docker files (not needed inside the image)
Dockerfile
.dockerignore
